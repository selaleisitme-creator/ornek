# Copy this file to .env.local and fill in the values from Supabase:
# Project Settings > API Keys. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# National ID (TC) encryption key: 32 random bytes in base64. Generate once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: if it is lost, every stored national ID becomes unreadable.
NATIONAL_ID_KEY=

# Signs the 15-minute "code confirmed" cookie for refunds, stock removal and accounting.
# At least 32 random characters; generate the same way as above. Changing it only asks for the code again.
STEP_UP_SECRET=
